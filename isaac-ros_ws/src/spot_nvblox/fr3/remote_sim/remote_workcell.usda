#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "physics"
    {
        float physics:gravityMagnitude = 9.81
    }

    def DomeLight "light"
    {
        float inputs:intensity = 1500
    }

    def Cube "floor" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.18, 0.2, 0.22)]
        double size = 1
        float3 xformOp:scale = (8, 8, 0.08)
        double3 xformOp:translate = (0, 0, -0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "table" (
