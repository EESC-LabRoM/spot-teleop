# Use the official ROS Humble Desktop image (based on Ubuntu 22.04)
FROM osrf/ros:humble-desktop

# Set noninteractive mode for APT
ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/bin/bash
SHELL ["/bin/bash", "-c"]

# 1. INSTALL APT-FAST NON-INTERACTIVELY
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository -y ppa:apt-fast/stable \
    && apt-get update -q \
    # Set up the silent configuration for apt-fast
    && echo debconf apt-fast/maxdownloads string 16 | debconf-set-selections \
    && echo debconf apt-fast/dlflag boolean true | debconf-set-selections \
    && echo debconf apt-fast/aptmanager string apt-get | debconf-set-selections \
    && DEBIAN_FRONTEND=noninteractive apt-get install -yq --no-install-recommends apt-fast \
    && rm -rf /var/lib/apt/lists/*

# 1. INSTALL REMAINING SYSTEM DEPENDENCIES
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get update -q \
    && apt-fast install -yq --no-install-recommends \
    nodejs \
    python3-pip \
    python-is-python3 \
    python3-argcomplete \
    python3-colcon-common-extensions \
    python3-colcon-mixin \
    python3-rosdep \
    libpython3-dev \
    python3-tk \
    python3-typing-extensions \
    python3-pytest-cov \
    python3-protobuf \
    python3-vcstool \
    ros-humble-object-recognition-msgs \
    ros-humble-rtabmap-ros \
    ros-humble-octomap-server \
    ros-humble-moveit \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-controller-manager \
    ros-humble-controller-interface \
    ros-humble-hardware-interface \
    ros-humble-forward-command-controller \
    ros-humble-moveit-visual-tools \
    ros-humble-joint-state-publisher \
    ros-humble-joint-state-publisher-gui \
    ros-humble-launch-pytest \
    ros-humble-depth-image-proc \
    ros-humble-bondpy \
    udev \
    usbutils \
    && rm -rf /var/lib/apt/lists/*

# 2. INSTALL PYTHON PACKAGES
RUN python3 -m pip install --no-cache-dir \
    bosdyn-client==5.0.1.2 \
    bosdyn-mission==5.0.1.2 \
    bosdyn-choreography-client==5.0.1.2 \
    bosdyn-orbit==5.0.1.2 \
    mediapipe==0.10.21 \
    ultralytics

# 3. ENVIRONMENT & WORKSPACE SETUP
ENV HOME=/home/spot-teleop
ENV USER=root
WORKDIR /home/spot-teleop/spot-ros2_ws

# rosdep init is usually already run in the base image, so we just update
RUN rosdep update

#   35 packages had stderr output: chomp_motion_planner moveit2_tutorials moveit_chomp_optimizer_adapter moveit_core moveit_hybrid_planning moveit_kinematics moveit_planners_chomp moveit_planners_ompl moveit_ros_benchmarks moveit_ros_control_interface moveit_ros_move_group moveit_ros_occupancy_map_monitor moveit_ros_perception moveit_ros_planning moveit_ros_planning_interface moveit_ros_robot_interaction moveit_ros_visualization moveit_ros_warehouse moveit_servo moveit_setup_app_plugins moveit_setup_assistant moveit_setup_controllers moveit_setup_core_plugins moveit_setup_framework moveit_setup_srdf_plugins moveit_simple_controller_manager moveit_task_constructor_capabilities moveit_task_constructor_core moveit_task_constructor_demo moveit_task_constructor_visualization pilz_industrial_motion_planner pilz_industrial_motion_planner_testutils rviz_marker_tools spot_controllers spot_driver

# Set up bashrc
RUN echo 'source /opt/ros/humble/setup.bash' >> /root/.bashrc && \
    echo 'source /home/spot-teleop/spot-ros2_ws/install/setup.bash' >> /root/.bashrc

COPY spot-ros2_ws/src/spot_ros2 /home/spot-teleop/spot-ros2_ws/src/spot_ros2

# Execute installation scripts
RUN cd /home/spot-teleop/spot-ros2_ws/src/spot_ros2 && chmod +x install_spot_ros2.sh && ./install_spot_ros2.sh

# Install specific rosdep packages
RUN rosdep install --from-paths src --ignore-src -y -r --rosdistro=humble --skip-keys="ros-humble-warehouse-ros-mongo" || true

# Set default command
CMD ["/bin/bash"]

